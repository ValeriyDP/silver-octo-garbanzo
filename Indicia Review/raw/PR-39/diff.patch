+// quietPaths are operational endpoints (probes, metrics, info). Request logs
+// and trace spans skip them so Kubernetes probes do not bury real traffic.
+// Match URL.Path exactly: a longer path must still be logged and traced.
+var quietPaths = map[string]bool{
+	"/":               true,
+	"/health":         true,
+	"/health/live":    true,
+	"/health/metrics": true,
+	"/health/workers": true,
+	"/ready":          true,
+	"/info":           true,
+}
+
+// traceRequest reports whether otelgin should start a span. WithFilter
+// traces a request only when every filter returns true.
+func traceRequest(r *http.Request) bool {
+	return !quietPaths[r.URL.Path]
+}

@@ -0,0 +1,68 @@
+package api
+
+import (
+	"context"
+	"testing"
+
+	"github.com/rs/zerolog"
+	"go.opentelemetry.io/otel"
+	sdktrace "go.opentelemetry.io/otel/sdk/trace"
+	"go.opentelemetry.io/otel/sdk/trace/tracetest"
+
+	"github.com/inveniamcapital/InveniamIndicia/internal/config"
+)
+
+// TestRouter_QuietPathsAreNotTraced pins INV-43586: probe and other
+// operational paths produce no spans, and a normal request still does.
+func TestRouter_QuietPathsAreNotTraced(t *testing.T) {
+	recorder := tracetest.NewSpanRecorder()
+	provider := sdktrace.NewTracerProvider(sdktrace.WithSpanProcessor(recorder))
+	previous := otel.GetTracerProvider()
+	otel.SetTracerProvider(provider)
+	t.Cleanup(func() {
+		otel.SetTracerProvider(previous)
+		if err := provider.Shutdown(context.Background()); err != nil {
+			t.Errorf("shutdown tracer provider: %v", err)
+		}
+	})
+
+	cfg := &config.Config{
+		Environment: "development",
+		Tracing:     config.TracingConfig{Enabled: true},
+	}
+	router := NewRouter(cfg, zerolog.Nop(), &Dependencies{Config: cfg})
+
+	for _, path := range []string{
+		"/",
+		"/health",
+		"/health/live",
+		"/health/metrics",
+		"/health/workers",
+		"/ready",
+		"/info",
+	} {
+		doGet(router, path, "")
+		if got := recorder.Ended(); len(got) != 0 {
+			t.Fatalf("GET %s produced %d spans, want 0", path, len(got))
+		}
+	}
+
+	const traced = "/v1/events"
+	doGet(router, traced, "")
+	ended := recorder.Ended()
+	if len(ended) != 1 {
+		t.Fatalf("GET %s produced %d spans, want 1", traced, len(ended))
+	}
+	if got := spanURLPath(ended[0]); got != traced {
+		t.Errorf("span url.path = %q, want %q", got, traced)
+	}
+}
+
+func spanURLPath(span sdktrace.ReadOnlySpan) string {
+	for _, attr := range span.Attributes() {
+		if string(attr.Key) == "url.path" {
+			return attr.Value.AsString()
+		}
+	}
+	return ""
+}

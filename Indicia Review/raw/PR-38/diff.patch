+// initTracing sets up OpenTelemetry tracing. A disabled config returns a no-op
+// provider.
+//
+//nolint:gocritic // hugeParam: zerolog.Logger is designed for by-value use.
+func initTracing(ctx context.Context, cfg sidecar.Config, logger zerolog.Logger) (*tracing.TracerProvider, error) {
+	tracerProvider, err := tracing.Setup(ctx, &tracing.Config{
+		Enabled:        cfg.Tracing.Enabled,
+		ServiceName:    "indicia-sidecar",
+		ServiceVersion: Version,
+		Environment:    cfg.Environment,
+		OTLPEndpoint:   cfg.Tracing.OTLPEndpoint,
+		Insecure:       cfg.Tracing.Insecure,
+		SampleRate:     cfg.Tracing.SampleRate,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("setup tracing: %w", err)
+	}
+
+	if cfg.Tracing.Enabled && cfg.Tracing.OTLPEndpoint != "" {
+		level := zerolog.InfoLevel
+		if cfg.Tracing.Insecure {
+			level = zerolog.WarnLevel
+		}
+		logger.WithLevel(level).
+			Str("endpoint", cfg.Tracing.OTLPEndpoint).
+			Float64("sample_rate", cfg.Tracing.SampleRate).
+			Bool("insecure", cfg.Tracing.Insecure).
+			Msg("OpenTelemetry tracing enabled")
+	}
+
+	return tracerProvider, nil
+}
+
+// shutdownTracer flushes in-flight spans. The timeout is independent of the
+// signal context, which is already canceled by the time this runs.
+//
+//nolint:gocritic // hugeParam: zerolog.Logger is designed for by-value use.
+func shutdownTracer(tp *tracing.TracerProvider, logger zerolog.Logger) {
+	shutdownCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	if err := tp.Shutdown(shutdownCtx); err != nil {
+		logger.Error().Err(err).Msg("failed to shutdown tracer provider")
+	}
+}

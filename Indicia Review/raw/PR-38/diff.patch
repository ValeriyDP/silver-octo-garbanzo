+	traceparent := headers.Get("traceparent")
+	traceID := span.SpanContext().TraceID().String()
+	if !strings.Contains(traceparent, traceID) {
+		t.Fatalf("traceparent = %q, want it to carry trace id %s", traceparent, traceID)
+	}
+	if headers.Get("baggage") != "" {
+		t.Fatalf("baggage = %q, want none forwarded to core", headers.Get("baggage"))
+	}
+	if headers.Get("Authorization") != "Bearer tok" {
+		t.Fatalf("Authorization = %q", headers.Get("Authorization"))
+	}
+	if headers.Get("Content-Type") != "application/json" {
+		t.Fatalf("Content-Type = %q", headers.Get("Content-Type"))
+	}
+	if headers.Get("Idempotency-Key") != "" {
+		t.Fatalf("Idempotency-Key = %q, want empty", headers.Get("Idempotency-Key"))
+	}
+	for key, values := range headers {
+		for _, value := range values {
+			for _, secret := range []string{"analyzer", "pseudo-abc", "0xdeadbeef", "baggage-marker"} {
+				if strings.Contains(value, secret) {

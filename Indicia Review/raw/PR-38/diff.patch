+			name:    "unparseable insecure flag",
+			env:     map[string]string{"INDICIA_OTEL_INSECURE": "yes"},
+			wantErr: "INDICIA_OTEL_INSECURE",
+		},
+		{
+			name: "url endpoint while tracing enabled",
+			env: map[string]string{
+				"INDICIA_TRACING_ENABLED": "true",
+				"INDICIA_OTEL_ENDPOINT":   "https://collector:4318",
+			},
+			wantErr: "INDICIA_OTEL_ENDPOINT",
+		},
+		{
+			name: "production refuses cleartext even when tracing is disabled",
+			env: map[string]string{
+				"INDICIA_ENVIRONMENT":   "production",
+				"INDICIA_OTEL_INSECURE": "true",
+			},
+			wantErr: "INDICIA_OTEL_INSECURE",
+		},
+		{
+			name:    "unknown environment name",
+			env:     map[string]string{"INDICIA_ENVIRONMENT": "prod"},
+			wantErr: `invalid environment "prod"`,
+		},
+		{
+			name: "host port endpoint while tracing enabled",
+			env: map[string]string{
+				"INDICIA_TRACING_ENABLED": "true",
+				"INDICIA_OTEL_ENDPOINT":   "collector.example:4318",
+				"INDICIA_ENVIRONMENT":     "staging",
+			},
+			want: func(t *testing.T, cfg sidecar.Config) {
+				t.Helper()
+				if cfg.Environment != "staging" {
+					t.Fatalf("Environment = %q, want staging", cfg.Environment)
+				}
+				if !cfg.Tracing.Enabled {
+					t.Fatal("Tracing.Enabled = false, want true")
+				}
+				if cfg.Tracing.OTLPEndpoint != "collector.example:4318" {
+					t.Fatalf("OTLPEndpoint = %q", cfg.Tracing.OTLPEndpoint)
+				}
+				if cfg.Tracing.Insecure {
+					t.Fatal("Tracing.Insecure = true, want false")
+				}
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			clearSidecarEnv(t)
+			setRequiredEnv(t)
+			for k, v := range tt.env {
+				t.Setenv(k, v)
+			}
+			cfg, err := sidecar.LoadConfig()
+			if tt.wantErr != "" {
+				if err == nil {
+					t.Fatal("expected an error, got nil")
+				}
+				if !strings.Contains(err.Error(), tt.wantErr) {
+					t.Fatalf("error %q does not contain %q", err, tt.wantErr)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("LoadConfig: %v", err)
+			}
+			tt.want(t, cfg)
+		})
+	}
+}

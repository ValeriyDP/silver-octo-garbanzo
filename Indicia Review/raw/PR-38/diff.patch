+		if parent.SpanID() != server.SpanID() {
+			t.Fatalf("call %d client span parent = %s, want server span %s", i, parent.SpanID(), server.SpanID())
+		}
+		if hdr.Get("baggage") != "" {
+			t.Fatalf("call %d baggage = %q, want none", i, hdr.Get("baggage"))
+		}
+	}

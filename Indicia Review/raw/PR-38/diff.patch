+	ctx, span := tp.Tracer("test").Start(context.Background(), "parent")
+	defer span.End()
+	member, err := baggage.NewMember("k", "baggage-marker")
+	if err != nil {
+		t.Fatal(err)
+	}
+	bag, err := baggage.New(member)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx = baggage.ContextWithBaggage(ctx, bag)
+
+	env := sampleEnvelope()
+	env.Tier1 = map[string]any{"agent_type": "analyzer"}
+	env.Tier2 = map[string]string{"user_id": "pseudo-abc"}
+	env.Tier3 = map[string]string{"prompt": "0xdeadbeef"}
+
+	var headers http.Header
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		headers = r.Header.Clone()
+		w.WriteHeader(http.StatusAccepted)
+		if _, err := w.Write([]byte(`{"event_id":"evt-1"}`)); err != nil {
+			t.Errorf("write response: %v", err)
+		}
+	}))
+	defer srv.Close()
+
+	// nil client is the production path: the instrumented transport.
+	c := coreclient.New(srv.URL, nil)
+	if _, err := c.PostEnvelope(ctx, "Bearer tok", env); err != nil {
+		t.Fatalf("PostEnvelope: %v", err)
+	}

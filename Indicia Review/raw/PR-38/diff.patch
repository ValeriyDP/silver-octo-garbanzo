+// newCoreTransport records a client span for the call to core and forwards
+// trace context only. W3C baggage stays behind: a producer-supplied baggage
+// header can carry anything, and the core is the process that never holds
+// content. With tracing disabled the global tracer is a no-op, so the
+// transport adds no header and no span.
+func newCoreTransport() http.RoundTripper {
+	return otelhttp.NewTransport(http.DefaultTransport, otelhttp.WithPropagators(propagation.TraceContext{}))

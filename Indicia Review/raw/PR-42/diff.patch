+// serverIntegritySentinels are the immudb store errors that mean stored history
+// cannot be trusted when they arrive as a raw gRPC status. immudb v1.11.2
+// mapServerError assigns them no code and no schema.ErrorInfo, and VerifiedGet
+// does not convert them back to the sentinel. Their text is read from this
+// module so an SDK reword changes the match; TestServerIntegritySentinelText
+// fails when that happens.
+var serverIntegritySentinels = []error{store.ErrCorruptedData, store.ErrCorruptedTxData}
+
 // isIntegrityError reports whether err is one of the immudb sentinels that mean
 // the server's history does not match the client's trusted state. Transport,
 // session, and not-found errors are not integrity failures.
+//
+// Client-local sentinels compare by identity via errors.Is. A server-returned
+// store.ErrCorruptedData or store.ErrCorruptedTxData does not: isServerIntegrityStatus
+// matches the raw gRPC status instead. A server binary that rewords either
+// sentinel without this same client module misses the latch.
 func isIntegrityError(err error) bool {
 	return errors.Is(err, store.ErrCorruptedData) ||
+		errors.Is(err, store.ErrCorruptedTxData) ||
 		errors.Is(err, immudb.ErrServerStateIsOlder) ||
 		errors.Is(err, immucache.ErrServerIdentityValidationFailed) ||
-		errors.Is(err, immucache.ErrLocalStateCorrupted)
+		errors.Is(err, immucache.ErrLocalStateCorrupted) ||
+		isServerIntegrityStatus(err)
+}
+
+// isServerIntegrityStatus reports whether err is the gRPC status immudb v1.11.2
+// sends for a serverIntegritySentinels value. The server attaches no
+// schema.ErrorInfo and no dedicated code, so the match is the pinned sentinel
+// text from this module. codes.Unknown covers the plain or fmt.Errorf-wrapped
+// sentinel, and codes.Internal covers a later wrap as an uncoded *immuError.
+// immudb joins wraps with ": ", in either order, so any whole segment equal to
+// a sentinel's text counts. "data is corrupted: value length or digest mismatch"
+// and "error reading tx metadata attributes: data is corrupted" both match.
+func isServerIntegrityStatus(err error) bool {
+	st, ok := status.FromError(err)
+	if !ok || st == nil {
+		return false
+	}
+	if code := st.Code(); code != codes.Unknown && code != codes.Internal {
+		return false
+	}
+	for _, segment := range strings.Split(st.Message(), ": ") {
+		for _, sentinel := range serverIntegritySentinels {
+			if segment == sentinel.Error() {
+				return true
+			}
+		}
+	}
+	return false
 }
 

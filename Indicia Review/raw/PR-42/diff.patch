+func TestDoAudit_ServerCorruptedDataLatches(t *testing.T) {
+	before := auditCount(auditResultIntegrityFailure)
+	c := newAuditClient(func(context.Context, []byte, ...immudbclient.GetOption) (*schema.Entry, error) {
+		return nil, status.Error(codes.Unknown, store.ErrCorruptedData.Error())
+	})
+
+	c.doAudit(context.Background())
+
+	if !c.IntegrityFailed() {
+		t.Fatal("expected integrity latch")
+	}
+	if got := testutil.ToFloat64(metrics.ImmudbIntegrityFailed); got != 1 {
+		t.Fatalf("integrity gauge = %v, want 1", got)
+	}
+	if got := auditCount(auditResultIntegrityFailure); got != before+1 {
+		t.Fatalf("integrity_failure = %v, want %v", got, before+1)
+	}
+}
+

@@ -128,3 +132,40 @@ func TestWireAudit(t *testing.T) {
 		}
 	})
 }
+
+// TestInitStorage_ImmudbUnreachable_ReturnsError pins immudb as a hard
+// startup dependency. A process that kept running after a failed connect
+// would start event workers with a nil client, and those workers would
+// dead-letter events from the shared Redis stream.
+func TestInitStorage_ImmudbUnreachable_ReturnsError(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	addr, ok := ln.Addr().(*net.TCPAddr)
+	if !ok {
+		t.Fatalf("listener addr %T is not *net.TCPAddr", ln.Addr())
+	}
+	port := addr.Port
+	if err := ln.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	logger := zerolog.Nop()
+	cfg := &config.Config{
+		Postgres: config.PostgresConfig{Host: "127.0.0.1", Port: port},
+		Immudb:   config.ImmudbConfig{Host: "127.0.0.1", Port: port},
+	}
+
+	clients, err := initStorage(context.Background(), cfg, &logger, nil)
+	if clients != nil {
+		clients.close(context.Background(), &logger)
+		t.Fatal("expected nil clients when immudb connect fails")
+	}
+	if err == nil {
+		t.Fatal("expected error when immudb is unreachable")
+	}
+	if !strings.Contains(err.Error(), "immudb") {
+		t.Fatalf("error = %q, want it to mention immudb", err)
+	}
+}

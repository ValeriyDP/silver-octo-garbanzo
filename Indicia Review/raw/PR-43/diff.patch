index 48f8524..1f7bc53 100644
--- a/internal/keyvault/locks.go
+++ b/internal/keyvault/locks.go
@@ -23,8 +23,22 @@ func fnv1a(s string) uint32 {
 	return h
 }
 
+func (l *shardedLocks) shard(tenantID, subjectID string) *sync.Mutex {
+	return &l.shards[fnv1a(tenantID+sep+subjectID)%uint32(len(l.shards))]
+}
+
 func (l *shardedLocks) lock(tenantID, subjectID string) func() {
-	m := &l.shards[fnv1a(tenantID+sep+subjectID)%uint32(len(l.shards))]
+	m := l.shard(tenantID, subjectID)
 	m.Lock()
 	return m.Unlock
 }
+
+// tryLock acquires the subject's shard if it is free. Tests use it to prove a
+// caller still holds the shard lock; production paths use lock.
+func (l *shardedLocks) tryLock(tenantID, subjectID string) (func(), bool) {
+	m := l.shard(tenantID, subjectID)
+	if !m.TryLock() {
+		return nil, false
+	}
+	return m.Unlock, true
+}

+// destroyGate blocks inside DestroySubjectKey after the subject key is gone.
+// Tests use that pause to observe the shard lock EraseSubject and
+// destroySubjectLocked hold across the call. provisions counts EnsureSubjectKey
+// and GenerateDEK calls made while the gate is closed.
+type destroyGate struct {
+	*kms.Fake
+	entered       chan struct{}
+	releaseCh     chan struct{}
+	provisioned   chan struct{} // closed on the first provision while the gate is closed
+	releaseOnce   sync.Once
+	enterOnce     sync.Once
+	provisionOnce sync.Once
+	inWindow      atomic.Bool
+	provisions    atomic.Int32
+}
+
+func newDestroyGate(t *testing.T) *destroyGate {
+	t.Helper()
+	g := &destroyGate{
+		Fake:        kms.NewFake(),
+		entered:     make(chan struct{}),
+		releaseCh:   make(chan struct{}),
+		provisioned: make(chan struct{}),
+	}
+	t.Cleanup(g.release)
+	return g
+}
+
+func (g *destroyGate) release() {
+	g.releaseOnce.Do(func() { close(g.releaseCh) })
+}
+
+func (g *destroyGate) DestroySubjectKey(ctx context.Context, tenantID, subjectID string) error {
+	if err := g.Fake.DestroySubjectKey(ctx, tenantID, subjectID); err != nil {
+		return err
+	}
+	g.inWindow.Store(true)
+	g.enterOnce.Do(func() { close(g.entered) })
+	<-g.releaseCh
+	g.inWindow.Store(false)
+	return nil
+}
+
+func (g *destroyGate) noteProvision() {
+	if g.inWindow.Load() {
+		g.provisions.Add(1)
+		g.provisionOnce.Do(func() { close(g.provisioned) })
+	}
+}
+
+func (g *destroyGate) EnsureSubjectKey(ctx context.Context, tenantID, subjectID string) error {
+	g.noteProvision()
+	return g.Fake.EnsureSubjectKey(ctx, tenantID, subjectID)
+}
+
+func (g *destroyGate) GenerateDEK(ctx context.Context, tenantID, subjectID string) ([]byte, []byte, error) {
+	g.noteProvision()
+	return g.Fake.GenerateDEK(ctx, tenantID, subjectID)
+}
+
+// requireShardHeldDuringDestroy waits until the key is destroyed and the gate
+// is still closed, then fails if that subject's shard lock is free.
+func requireShardHeldDuringDestroy(t *testing.T, v *Keyvault, g *destroyGate, tenantID, subjectID, holder string) {
+	t.Helper()
+	<-g.entered
+	if unlock, ok := v.locks.tryLock(tenantID, subjectID); ok {
+		unlock()
+		t.Fatalf("%s is not holding v.locks.lock(%s, %s) across DestroySubjectKey", holder, tenantID, subjectID)
+	}
+}
+
+// provisionWindow is how long the destroy gate stays closed after the seals
+// start. A seal that skips the shard lock reaches the KMS in microseconds, so
+// this window catches it every time; correct code never provisions in it.
+const provisionWindow = 50 * time.Millisecond
+
+// requireNoProvisionWhileGateClosed fails if a seal reaches EnsureSubjectKey or
+// GenerateDEK before the destroy gate opens. Callers start the seals first and
+// keep the gate closed for provisionWindow.
+func requireNoProvisionWhileGateClosed(t *testing.T, g *destroyGate) {
+	t.Helper()
+	select {
+	case <-g.provisioned:
+		t.Fatalf("EnsureSubjectKey/GenerateDEK ran %d times while DestroySubjectKey was blocked", g.provisions.Load())
+	case <-time.After(provisionWindow):
+	}
+}

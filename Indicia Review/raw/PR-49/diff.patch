+// writeResolveCompanyIDError maps a resolveCompanyID failure for GET /events
+// and GET /batches. A missing company and the static client errors stay 400
+// with the existing message. Any other lookup failure is 500 with a fixed
+// body; the driver text is logged and omitted from the response.
+func (h *EventsHandler) writeResolveCompanyIDError(c *gin.Context, externalIDParam string, err error) {
+	if errors.Is(err, core.ErrCompanyNotFound) || isClientCompanyResolveError(err) {
+		c.JSON(http.StatusBadRequest, ErrorResponse{
+			Error:   codeInvalidRequest,
+			Message: err.Error(),
+		})
+		return
+	}
+	log.Error().Err(err).Str("external_id", externalIDParam).Msg("failed to resolve external_id")
+	c.JSON(http.StatusInternalServerError, ErrorResponse{
+		Error:   codeInternalError,
+		Message: msgFailedResolveExternalID,
+	})
+}
+
+// isClientCompanyResolveError reports the unwrapped validation errors
+// resolveCompanyID returns before it calls the store.
+func isClientCompanyResolveError(err error) bool {
+	switch err.Error() {
+	case msgCannotProvideBothIDs, msgEitherCompanyOrExternalID, msgCompanyServiceNotAvailable:
+		return true
+	default:
+		return false
+	}
+}
